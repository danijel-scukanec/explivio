{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    // TS 7.0 flags the classic "node" (node10) resolver as deprecated (TS5107). We keep it — it matches
    // this package's CommonJS dist output and consumers resolve it fine — and silence the hard error so
    // `npm install` / `prepare` (tsc) don't fail. Revisit with "node16"/"bundler" in a TS-upgrade pass.
    "ignoreDeprecations": "6.0",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
