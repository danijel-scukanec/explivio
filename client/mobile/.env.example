# Explivio mobile — Expo public env vars. Copy what you need into a gitignored `.env.local`.
# EXPO_PUBLIC_* values are inlined into the bundle at build time (restart Metro after changing them).

# Backend API base. localhost works for `expo start --web`; a real device/emulator needs the host's
# LAN IP (see the F31 phone-run notes).
# EXPO_PUBLIC_API_URL=http://localhost:5298

# Web app base (used for share links).
# EXPO_PUBLIC_WEB_URL=http://localhost:5173

# Google Places (New) key for place search.
# EXPO_PUBLIC_GOOGLE_PLACES_KEY=...

# P-Auth — Microsoft Entra External ID sign-in. Set ALL THREE to turn real auth ON; leave unset to
# keep the dev-identity flow (no auth header → default dev user). Public identifiers, not secrets.
# NOTE: the custom-scheme redirect (explivio://auth) needs a dev build; in Expo Go the redirect is an
# exp:// proxy URL that must also be added to the native app registration.
# EXPO_PUBLIC_ENTRA_AUTHORITY=https://<tenant>.ciamlogin.com/<tenantId>/v2.0
# EXPO_PUBLIC_ENTRA_CLIENT_ID=<native-client-id>
# EXPO_PUBLIC_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
