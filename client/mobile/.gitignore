# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# F20 (push): FCM service-account keys are secrets — never commit. The one in use lives OUTSIDE the
# repo (~/explivio-...-firebase-adminsdk-*.json) and is uploaded to EAS. google-services.json is NOT a
# secret and is committed (EAS cloud builds need it). These patterns guard against a stray copy.
*firebase-adminsdk*.json
*service-account*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
