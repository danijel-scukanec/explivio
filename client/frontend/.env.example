# Explivio web — environment variables. Copy the ones you need into a gitignored `.env.local`.

# Backend API base (defaults to http://localhost:5298 when unset).
# VITE_API_URL=http://localhost:5298

# Google Places (New) key for the place-search autocomplete.
# VITE_GOOGLE_PLACES_KEY=...

# P-Auth — Microsoft Entra External ID sign-in. Set ALL THREE to turn real auth ON; leave them unset
# to keep the local dev-identity flow (X-Dev-User impersonation). These are public identifiers, not
# secrets. Fill from the Explivio Web (SPA) + API app registrations in the External ID tenant.
#   Authority: https://<tenant>.ciamlogin.com/<tenantId>/v2.0
#   Client ID: the SPA app registration's Application (client) ID
#   API scope: the API app's exposed scope, api://<apiClientId>/access_as_user
# VITE_ENTRA_AUTHORITY=https://<tenant>.ciamlogin.com/<tenantId>/v2.0
# VITE_ENTRA_CLIENT_ID=<spa-client-id>
# VITE_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
