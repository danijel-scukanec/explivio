<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <ItemGroup>
    <ProjectReference Include="..\Explivio.API\Explivio.API.csproj" />
    <ProjectReference Include="..\Explivio.AIWorker\Explivio.AIWorker.csproj" />
    <ProjectReference Include="..\Explivio.NotificationsWorker\Explivio.NotificationsWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.4.6" />
    <!-- Override transitive vulnerable System.Security.Cryptography.Pkcs (NU1902/NU1903) with the patched
         net10 servicing version. Mirrors the API + workers. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Override MessagePack 2.5.302 (pulled via Aspire.Hosting → StreamJsonRpc) with 2.5.303, the patch
         that fixes GHSA-qhrr-8q5h-9q3h (NU1902). Same-minor bump, API-compatible. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>4c36436d-f49a-4982-83ba-6d791728bb21</UserSecretsId>
  </PropertyGroup>

</Project>
