    <ProjectReference Include="..\Explivio.NotificationsWorker\Explivio.NotificationsWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.ApplicationInsights" />
