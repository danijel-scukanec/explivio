{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "PushNotifications": {
    "Enabled": false,
    "ExpoAccessToken": ""
  },
  // F20 (web push): the VAPID keypair + subject the worker signs browser push with. Public key is also
  // served to clients by the API (keep them identical). Empty = web push off. The PRIVATE key is a
  // secret — leave it empty here and set it in the gitignored appsettings.Development.json (or
  // user-secrets / Key Vault), never commit it. Generate once (e.g. `npx web-push generate-vapid-keys`).
  "WebPush": {
    "PublicKey": "",
    "PrivateKey": "",
    "Subject": "mailto:admin@explivio.app"
  }
}
