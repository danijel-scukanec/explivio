<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageReference Include="Aspire.Azure.Messaging.ServiceBus" Version="13.4.6" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.4.6" />
    <PackageReference Include="Aspire.Microsoft.Azure.Cosmos" Version="13.4.6" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.60.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.8.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- F25: PDF budget export. Community license (free under the revenue threshold — same posture as
         MediatR for this personal portfolio); the license type is set at startup in Program.cs. -->
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- F22: transitive-CVE override. Aspire.Azure.Storage.Blobs → Azure.Storage.Blobs → MSAL drags in
         System.Security.Cryptography.Pkcs 9.0.4 (NU1903 high, GHSA-846f-f764-76mx). The Aspire set is
         pinned at 13.4.6 so we can't bump the parent; pin the patched .NET 10 package directly instead. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- F14: the RAG seed corpus, read at runtime via reflection (PlaceCorpus). -->
    <EmbeddedResource Include="Infrastructure\Rag\places.seed.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Explivio.Messaging\Explivio.Messaging.csproj" />
    <ProjectReference Include="..\Explivio.ServiceDefaults\Explivio.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
