{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:8081" ]
  },
  "FeatureManagement": {
    "AiItineraryGeneration": true,
    "TripCoverPhotos": true,
    "TripDocuments": true,
    "AiAssistant": true
  },
  // P-Auth: Microsoft Entra External ID (CIAM) bearer-token validation. Left empty on purpose —
  // auth stays dormant until these are filled, and locally the Development fake-identity middleware
  // supplies the user instead, so the app runs without a real tenant. Fill from the API app
  // registration once the Entra External ID tenant exists; prefer user-secrets / Key Vault over
  // committing real values. When Authority is set, bearer tokens are validated against it.
  //   Authority: the tenant's v2.0 issuer, e.g. https://<subdomain>.ciamlogin.com/<tenantId>/v2.0
  //   Audience:  the API app registration's Application (client) ID, or its api://<clientId> URI
  "Entra": {
    "Authority": "",
    "Audience": ""
  }
}
