{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": ""
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:8081" ]
  },
  "FeatureManagement": {
    "AiItineraryGeneration": true,
    "TripCoverPhotos": true,
    "TripDocuments": true,
    "AiAssistant": true,
    "AiReceiptScanning": true,
    "AiTripRecap": true,
    "AiEmailParsing": true,
    "AiSemanticCache": true,
    "AiContentSafety": true,
    "PushNotifications": true
  },
  // F21: AI-ops config. Pricing drives the estimated-cost figures in the usage view and the cost
  // metric (USD per 1,000,000 tokens, keyed by model name — these are ESTIMATES, adjust to your
  // actual Azure OpenAI rates). Endpoint/ApiKey/Model for the model itself live in user-secrets.
  "AI": {
    "Pricing": {
      "gpt-5-mini": { "InputPerMillion": 0.25, "OutputPerMillion": 2.00 },
      "gpt-4o-mini": { "InputPerMillion": 0.15, "OutputPerMillion": 0.60 },
      "text-embedding-3-small": { "InputPerMillion": 0.02, "OutputPerMillion": 0.00 }
    },
    "SemanticCache": { "Threshold": 0.95 },
    // Azure AI Content Safety — empty = use the local keyword stand-in. Fill (prefer user-secrets)
    // to moderate with the real service. Threshold is the Azure severity (0-7) at which to block.
    "ContentSafety": { "Endpoint": "", "ApiKey": "", "Threshold": 4 }
  },
  // P-Auth: Microsoft Entra External ID (CIAM) bearer-token validation. Left empty on purpose —
  // auth stays dormant until these are filled, and locally the Development fake-identity middleware
  // supplies the user instead, so the app runs without a real tenant. Fill from the API app
  // registration once the Entra External ID tenant exists; prefer user-secrets / Key Vault over
  // committing real values. When Authority is set, bearer tokens are validated against it.
  //   Authority: the tenant's v2.0 issuer, e.g. https://<subdomain>.ciamlogin.com/<tenantId>/v2.0
  //   Audience:  the API app registration's Application (client) ID, or its api://<clientId> URI
  "Entra": {
    "Authority": "",
    "Audience": ""
  },
  // F20 (web push): the VAPID public key the web client fetches (GET /devices/web/vapid-key) to
  // subscribe for browser push. Non-secret — the private half lives only on the Notifications Worker.
  // Empty = web push off (the client won't offer it). Generate a keypair once (e.g.
  // `npx web-push generate-vapid-keys`) and put the public key here; keep it in sync with the worker.
  "WebPush": {
    "PublicKey": "",
    "Subject": "mailto:admin@explivio.app"
  }
}
